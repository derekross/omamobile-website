# The web installer at /install/web/app/: the one switch, and the pin.
#
# INSTALLER_WEB=off (as committed): the site builds and deploys exactly as
# without this file. No installer is fetched, /install/web/ and
# /install/web/app/ are not built, and nothing about the server changes.
#
# INSTALLER_WEB=on: the build also makes the draft page /install/web/, and
# scripts/installer-web.sh puts the installer's shipping web build at
# dist/install/web/app/. It takes the asset of one tagged release of
# derekross/omamobile-installer, named below, and refuses it unless its
# SHA-256 is the one written here: the hash in this file, reviewed in a pull
# request, is what the site trusts, not the release page.
#
# Turning it on is the maintainer's decision, after the go-live checklist in
# the installer repository (docs/GO-LIVE.md). The server's Permissions-Policy
# for /install/web/app/ is a separate change on the server, made by hand
# (docs/INSTALLER-WEB.md); this file cannot make it.
#
# Read by scripts/installer-web.sh (bash) and src/lib/installer-web.ts: plain
# KEY=value lines, no quotes, no spaces.
INSTALLER_WEB=off
# The installer release's tag, e.g. v0.1.0. Its asset is
# omamobile-installer-web-<TAG>.tar.gz.
INSTALLER_WEB_TAG=
# The SHA-256 of that asset: 64 lowercase hex digits, from the release's
# SHA256SUMS, checked against a build of the tagged commit.
INSTALLER_WEB_SHA256=
