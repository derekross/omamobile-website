---
import "@fontsource-variable/jetbrains-mono";
import "@fontsource-variable/geist";
import "../styles/global.css";
import themes from "../lib/themes.json";
import { REPO_URL } from "../lib/devices";

interface Props {
  title?: string;
  description?: string;
}
const {
  title,
  description = "Native Omarchy on your phone: Arch Linux, Hyprland and Omarchy's apps on a mainline Linux kernel, with no Android underneath.",
} = Astro.props;
const fullTitle = title ? `${title} · Omarchy Mobile` : "Omarchy Mobile";
const path = Astro.url.pathname.replace(/\/$/, "") || "/";
const nav = [
  { href: "/devices", label: "Devices" },
  { href: `${REPO_URL}#quick-start`, label: "Install" },
  { href: "/news", label: "News" },
  { href: REPO_URL, label: "GitHub" },
];
const themeName = (t: string) => t.split("-").map((w) => w[0].toUpperCase() + w.slice(1)).join(" ");
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={new URL("/og.png", Astro.site)} />
    <meta property="og:image:width" content="1500" />
    <meta property="og:image:height" content="500" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" href="/favicon-48.png" type="image/png" sizes="48x48" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#1a1b26" />
    <script is:inline>
      try {
        const t = localStorage.getItem("theme");
        if (t) document.documentElement.dataset.theme = t;
      } catch {}
    </script>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="wrap bar">
        <a class="wordmark" href="/" aria-label="Omarchy Mobile, home"><span class="mark" aria-hidden="true">om</span>omarchy<span class="sub">mobile</span></a>
        <nav aria-label="Main">
          <ul>
            {nav.map((n) => (
              <li><a href={n.href} aria-current={path === n.href ? "page" : undefined}>{n.label}</a></li>
            ))}
          </ul>
        </nav>
      </div>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="wrap foot">
        <p>
          Omarchy Mobile is a community project built on <a href="https://omarchy.org">Omarchy</a>.
          It isn't an official Omarchy or Basecamp product. Code and site are MIT licensed,
          on <a href={REPO_URL}>GitHub</a>.<br />
          Nostr: <a href="https://njump.me/npub1epdgm26q2wx0ee37q8u692z8w2ngwqepd9fvxy04uml8nz7sx7fs9hkynf">@omamobile.org</a>
        </p>
        <label class="theme">
          <span>Theme</span>
          <select id="theme-picker">
            {themes.map((t) => <option value={t}>{themeName(t)}</option>)}
          </select>
        </label>
      </div>
    </footer>
    <script is:inline>
      (() => {
        const sel = document.getElementById("theme-picker");
        sel.value = document.documentElement.dataset.theme || "tokyo-night";
        sel.addEventListener("change", () => {
          document.documentElement.dataset.theme = sel.value;
          try { localStorage.setItem("theme", sel.value); } catch {}
        });
      })();
    </script>
  </body>
</html>

<style>
  .site-header { border-bottom: 1px solid var(--border); }
  .bar { display: flex; align-items: center; justify-content: space-between; gap: 1rem; min-height: 4rem; flex-wrap: wrap; }
  .wordmark {
    font-family: var(--font-mono); font-weight: 700; font-size: 1.125rem; letter-spacing: -0.03em;
    color: var(--text); text-decoration: none;
  }
  .wordmark { display: inline-flex; align-items: center; }
  .wordmark .sub { color: var(--accent); margin-left: 0.4ch; font-weight: 500; }
  /* The logo: a phone outline around "om", as on the project's Nostr profile. */
  .mark {
    display: inline-grid; place-items: center; position: relative;
    width: 1.6rem; height: 2.6rem; margin-right: 0.7rem;
    border: 3px solid var(--accent); border-radius: 0.4rem;
    font-size: 0.72rem; font-weight: 800; letter-spacing: -0.06em; color: var(--text);
  }
  .mark::before {
    content: ""; position: absolute; top: 0.17rem; left: 50%; transform: translateX(-50%);
    width: 0.24rem; height: 0.08rem; border-radius: 1px; background: var(--accent);
  }
  nav ul { list-style: none; display: flex; gap: clamp(0.75rem, 3vw, 1.75rem); margin: 0; padding: 0; flex-wrap: wrap; }
  nav a { font-family: var(--font-mono); font-size: 0.9375rem; color: var(--text-2); text-decoration: none; }
  nav a:hover, nav a[aria-current="page"] { color: var(--text); text-decoration: underline; text-decoration-color: var(--accent); }

  .site-footer { border-top: 1px solid var(--border); margin-top: 6rem; font-size: 0.875rem; color: var(--muted); }
  .foot { display: flex; justify-content: space-between; align-items: flex-start; gap: 2rem; padding-block: 2rem; flex-wrap: wrap; }
  .foot p { max-width: 52ch; margin: 0; }
  .theme { display: inline-flex; align-items: center; gap: 0.6rem; font-family: var(--font-mono); }
  .theme select {
    font: inherit; color: var(--text); background: var(--surface);
    border: 1px solid var(--border-strong); border-radius: var(--radius); padding: 0.35rem 0.5rem;
  }
</style>
