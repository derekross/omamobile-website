---
import Base from "../layouts/Base.astro";
import { featured, inProgress, parts, countStatus, STATUS_TEXT, REPO_URL, type Device } from "../lib/devices";

// "Pixel 7 Pro and Pixel 6 Pro", "A, B and C"
const names = (ds: Device[]) => {
  const t = ds.map((d) => `the ${d.title}`);
  return t.length < 2 ? (t[0] ?? "") : `${t.slice(0, -1).join(", ")} and ${t.at(-1)}`;
};
const strip = (d: Device) => parts(d).map((p) => ({ name: p.name, status: p.cell.status }));
const shots = [
  {
    file: "home-full.webp",
    caption: "The home screen, with widgets and a dock.",
    alt: "The home screen: a system-information widget, a weather widget, a wallpaper of purple hills, four apps in the dock and a search bar.",
  },
  {
    file: "quick-settings.webp",
    caption: "Quick settings, with brightness and volume.",
    alt: "Quick settings: tiles for Wi-Fi, Bluetooth, Do not disturb, the torch, mobile data, rotation lock, airplane mode and location, with brightness and volume sliders.",
  },
  {
    file: "apps.webp",
    caption: "Every app, with search and the on-screen keyboard.",
    alt: "The app list in a four-column grid, with the search bar and the on-screen keyboard open below it.",
  },
  {
    file: "terminal.webp",
    caption: "A terminal running an AI agent you pick at first login.",
    alt: "A terminal over the home screen running Claude Code, waiting for a prompt.",
  },
];
---
<Base>
  <section class="hero wrap">
    <div class="pitch">
      <h1>Omarchy, on your phone.</h1>
      <p class="lede">
        Omarchy Mobile runs native Omarchy on phones: Arch Linux ARM, Hyprland and Omarchy's own apps,
        on a mainline Linux kernel, with no Android underneath.
      </p>
      <p class="lede">
        It runs on {names(featured)} today, and community ports are bringing it to {inProgress.length} more phones.
      </p>
      <div class="actions">
        <a class="button primary" href={`${REPO_URL}#quick-start`}>Install it</a>
        <a class="button" href="#phones">See the phones</a>
      </div>
    </div>
    <figure class="phone">
      <img
        src="/screens/home.webp"
        width="720"
        height="1440"
        alt="The Omarchy Mobile home screen: a system-information widget showing Omarchy on kernel 7.3, a weather widget, and Chromium, Files, Foot and Omawrite in the dock."
        fetchpriority="high"
      />
    </figure>
  </section>

  <section class="wrap block" aria-labelledby="look">
    <div class="head">
      <h2 id="look">Omarchy, made for your hand</h2>
      <p>
        The same Omarchy you run on a laptop, with a shell made for a touchscreen: a home screen with widgets and a
        dock, quick settings a swipe away, every app with search and the on-screen keyboard, and a terminal with
        the AI agent you pick at first login.
      </p>
    </div>
    <ul class="shots">
      {shots.map((s) => (
        <li>
          <figure>
            <img src={`/screens/${s.file}`} width="720" height="1560" alt={s.alt} loading="lazy" decoding="async" />
            <figcaption>{s.caption}</figcaption>
          </figure>
        </li>
      ))}
    </ul>
  </section>

  <section class="wrap block" aria-labelledby="phones">
    <div class="head">
      <h2 id="phones">Phones</h2>
      <p>
        Each dot is one part of the phone:
        <span class="key"><span class="dot s-works"></span>works</span>
        <span class="key"><span class="dot s-testing"></span>testing</span>
        <span class="key"><span class="dot s-wip"></span>in progress</span>
        <span class="key"><span class="dot s-no"></span>not yet</span>.
        The status of every part, with the notes behind it, is on each phone's page.
      </p>
    </div>
    <ul class="featured">
      {featured.map((d) => (
        <li>
          <a class="card" href={`/devices/${d.codename}`}>
            <span class="title">{d.title}</span>
            <span class="soc">{d.soc}</span>
            <span class="dots" role="img" aria-label={`${countStatus(d, "works")} of ${parts(d).length} parts work`}>
              {strip(d).map((p) => <span class={`dot s-${p.status}`} title={`${p.name}: ${STATUS_TEXT[p.status]}`}></span>)}
            </span>
            <span class="count">{countStatus(d, "works")} of {parts(d).length} parts work</span>
          </a>
        </li>
      ))}
    </ul>
    <h3 class="sub">Ports under way</h3>
    <ul class="ports">
      {inProgress.map((d) => (
        <li>
          <a href={`/devices/${d.codename}`}>{d.title}</a>
          <span class="soc">{d.soc}</span>
          <span class="dots" role="img" aria-label={`${parts(d).length - countStatus(d, "no")} of ${parts(d).length} parts started`}>
            {strip(d).map((p) => <span class={`dot s-${p.status}`} title={`${p.name}: ${STATUS_TEXT[p.status]}`}></span>)}
          </span>
        </li>
      ))}
    </ul>
    <div class="actions">
      <a class="button" href="/devices">Compare every phone</a>
    </div>
  </section>

  <section class="wrap block" aria-labelledby="how">
    <h2 id="how">How it fits together</h2>
    <dl class="how">
      <div>
        <dt>A mainline kernel</dt>
        <dd>
          Our own drivers for the display, touch, cameras, audio and the rest, written against upstream Linux and
          published in <a href="https://github.com/derekross/linux-omarchy-mobile">linux-omarchy-mobile</a>.
        </dd>
      </div>
      <div>
        <dt>Your way back stays</dt>
        <dd>
          Installing writes only the phone's second boot slot and its user data. Stock Android stays on the other
          slot as your way back.
        </dd>
      </div>
      <div>
        <dt>Omarchy, updated like Omarchy</dt>
        <dd>
          <code>omarchy update</code> runs Omarchy's own update on the phone, with the phone's safeguards. The
          phone's own packages are signed, and will ship from their own repository beside Omarchy's.
        </dd>
      </div>
    </dl>
  </section>

  <section class="wrap block" aria-labelledby="ports">
    <div class="head">
      <h2 id="ports">Bring it to your phone</h2>
      <p>
        The wanted list names more phones, each with a starting point. The safety model comes first: stock stays on
        its own slot, and only our slot and the user data are ever written.
      </p>
    </div>
    <div class="actions">
      <a class="button" href="/devices#wanted">See the wanted list</a>
      <a class="button" href={`${REPO_URL}/blob/main/CONTRIBUTING.md`}>Read the contributor guide</a>
    </div>
  </section>
</Base>

<style>
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
    gap: clamp(2rem, 6vw, 5rem);
    align-items: center;
    padding-block: clamp(3rem, 8vw, 6rem) clamp(2rem, 5vw, 4rem);
  }
  .lede { font-size: clamp(1.0625rem, 1rem + 0.4vw, 1.25rem); color: var(--text-2); max-width: 40ch; }
  h1 { margin-bottom: 1.5rem; max-width: 12ch; }
  .actions { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 2rem; }

  .phone { margin: 0; justify-self: center; width: min(100%, 22rem); }
  .phone img {
    border-radius: 2.25rem;
    border: 10px solid var(--bg-deep);
    outline: 1px solid var(--border-strong);
    aspect-ratio: 1 / 2;
    object-fit: cover;
    width: 100%;
  }

  .block { padding-top: clamp(3rem, 7vw, 5rem); }
  .head { display: grid; gap: 0.75rem; margin-bottom: 2rem; }
  .head p { margin: 0; color: var(--text-2); }

  .shots {
    list-style: none; margin: 0; padding: 0;
    display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: clamp(1rem, 3vw, 2rem);
  }
  .shots figure { margin: 0; }
  .shots img {
    width: 100%; height: auto; border-radius: 1.25rem;
    border: 6px solid var(--bg-deep); outline: 1px solid var(--border-strong);
  }
  .shots figcaption { font-size: 0.875rem; color: var(--muted); margin-top: 0.75rem; }

  .how { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 18rem), 1fr)); gap: 2rem 3rem; margin: 2rem 0 0; }
  .how dt { font-family: var(--font-mono); font-weight: 600; color: var(--text); margin-bottom: 0.5rem; }
  .how dd { margin: 0; }

  .sub { font-size: 1rem; margin: 2.5rem 0 0.75rem; color: var(--text-2); }

  .dots { display: flex; flex-wrap: wrap; gap: 4px; }
  .dot { width: 0.6rem; height: 0.6rem; border-radius: 50%; background: currentColor; flex: none; }
  .dot.s-no, .dot.s-none { background: transparent; box-shadow: inset 0 0 0 1.5px currentColor; }
  .key { display: inline-flex; align-items: center; gap: 0.35em; margin-inline: 0.35em 0.15em; white-space: nowrap; }
  .key .dot { width: 0.55rem; height: 0.55rem; }

  .featured {
    list-style: none; margin: 0; padding: 0;
    display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 22rem), 1fr)); gap: 1rem;
  }
  .card {
    display: grid; gap: 0.5rem; height: 100%; padding: 1.25rem 1.5rem;
    border: 1px solid var(--border-strong); border-radius: 0.75rem; background: var(--surface);
    color: inherit; text-decoration: none;
  }
  .card:hover { border-color: var(--accent); }
  .card .title { font-size: 1.25rem; font-weight: 600; color: var(--text); }
  .card .dots { margin-top: 0.5rem; }
  .card .dot { width: 0.75rem; height: 0.75rem; }
  .count { font-family: var(--font-mono); font-size: 0.875rem; color: var(--works); }

  .ports { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--border); }
  .ports li {
    display: grid; grid-template-columns: minmax(0, 11rem) minmax(0, 14rem) minmax(0, 1fr); gap: 1rem; align-items: center;
    padding: 0.7rem 0; border-bottom: 1px solid var(--border);
  }
  .ports a { font-weight: 500; }
  .soc { color: var(--muted); font-size: 0.9375rem; }

  @media (max-width: 52rem) {
    .hero { grid-template-columns: 1fr; }
    .phone { width: min(80%, 18rem); }
    .shots { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 44rem) {
    .ports li { grid-template-columns: 1fr; gap: 0.35rem; }
  }
</style>
