---
import Base from "../../layouts/Base.astro";
import { getCollection, render, type CollectionEntry } from "astro:content";

export async function getStaticPaths() {
  return (await getCollection("news")).map((post) => ({ params: { slug: post.id }, props: { post } }));
}
const { post } = Astro.props as { post: CollectionEntry<"news"> };
const { Content } = await render(post);
const day = post.data.published.toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric", timeZone: "UTC" });
---
<Base title={post.data.title} description={post.data.summary}>
  <article class="wrap post">
    <p class="crumb"><a href="/news">News</a></p>
    <h1>{post.data.title}</h1>
    <p class="meta"><time datetime={post.data.published.toISOString()}>{day}</time></p>
    <div class="body"><Content /></div>
    <p class="nostr"><a href={`https://njump.me/${post.data.naddr}`}>Reply on Nostr</a></p>
  </article>
</Base>

<style>
  .post { padding-block: clamp(3rem, 7vw, 4.5rem) 2rem; }
  .crumb { font-family: var(--font-mono); font-size: 0.875rem; margin-bottom: 1rem; }
  .post h1 { font-size: clamp(2rem, 1.4rem + 3vw, 3.25rem); margin-bottom: 0.75rem; max-width: 20ch; }
  .meta { font-family: var(--font-mono); font-size: 0.875rem; color: var(--muted); margin-bottom: 2.5rem; }
  .body { max-width: var(--measure); }
  .body :global(h2) { font-size: 1.5rem; margin: 2.5rem 0 1rem; }
  .body :global(ul) { padding-left: 1.25rem; margin: 0 0 1em; }
  .body :global(li) { margin-bottom: 0.4rem; }
  .nostr { margin-top: 3rem; padding-top: 1.5rem; border-top: 1px solid var(--border); }
</style>
